{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cronpulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cronpulse",
      "database_id": "7d5f2fc6-f14c-4fea-9e5a-bc1a27e0f762",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "vars": {
    "WORKER_URL": "https://cronpulse.judixtester.workers.dev",
    "DASHBOARD_URL": "http://localhost:5173, http://localhost:5174, https://cronpulse.judixtester.workers.dev, https://roosters-alpha.vercel.app",
    "EMAIL_PROVIDER": "brevo",
    "EMAIL_FROM": "roosters.alert@gmail.com",
    "EMAIL_FROM_NAME": "Roosters",
    "USER_AGENT": "CronPulse/1.0 (scheduled HTTP monitor)"
  },
  "observability": {
    "enabled": true
  }
}
