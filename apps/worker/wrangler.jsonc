{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cronpulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cronpulse",
      "database_id": "REPLACE_ME_after_wrangler_d1_create",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "vars": {
    "WORKER_URL": "http://127.0.0.1:8787",
    "DASHBOARD_URL": "http://localhost:5173, http://localhost:5174, http://127.0.0.1:5173, http://127.0.0.1:5174",
    "EMAIL_PROVIDER": "log",
    "EMAIL_FROM": "alerts@example.com",
    "EMAIL_FROM_NAME": "CronPulse",
    "USER_AGENT": "CronPulse/1.0 (scheduled HTTP monitor)"
  },
  "observability": {
    "enabled": true
  }
}
